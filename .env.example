# Copy this file to .env and fill in your values.
# Leave the Supabase lines empty to run the site in DEMO mode (data stays in the browser).

# Supabase → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Razorpay → Account & Settings → API Keys (the *Key ID* only — never put the secret here)
VITE_RAZORPAY_KEY_ID=
